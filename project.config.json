{
  "description": "魔方教学小程序（三阶层先法 + CFOP），原生微信小程序",
  "appid": "touristappid",
  "projectname": "miniprogram-cube",
  "compileType": "miniprogram",
  "projectArchitecture": "miniProgram",
  "libVersion": "2.32.3",
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "tests" },
      { "type": "folder", "value": "tools" },
      { "type": "folder", "value": "node_modules" },
      { "type": "file", "value": "README.md" },
      { "type": "file", "value": "package.json" },
      { "type": "file", "value": "packageCube/data/README.md" }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXML": true,
    "minifyWXSS": true,
    "coverView": true,
    "showShadowRootInWxmlPanel": true,
    "ignoreUploadUnusedFiles": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {},
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
