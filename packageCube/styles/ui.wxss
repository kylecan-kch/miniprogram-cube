.cube-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f1f5f9;
  color: #0f172a;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  line-height: 1.5;
  padding-bottom: 48rpx;
}

.cube-card {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
}

.cube-card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.cube-muted {
  color: #64748b;
  font-size: 24rpx;
}

.cube-h1 {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.cube-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 28rpx;
  margin: 8rpx 16rpx 8rpx 0;
  border-radius: 14rpx;
  width: auto !important;
  min-width: 0;
  font-weight: 500;
  font-size: 26rpx;
  background: #eff6ff;
  color: #1d4ed8;
  line-height: 72rpx;
}

.cube-btn::after { border: none; }

.cube-btn-primary { background: #2563eb; color: #ffffff; }

.cube-btn-plain { background: #f1f5f9; color: #334155; }

.cube-btn[disabled] { opacity: 0.45; }

.cube-btn-hover { opacity: 0.85; }

.cube-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.cube-track {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.cube-track-main { flex: 1; }

.cube-track-arrow {
  color: #94a3b8;
  font-size: 36rpx;
  margin-left: 12rpx;
}

.cube-badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.cube-case {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: #fef3c7;
  color: #92400e;
  font-size: 24rpx;
  font-weight: 600;
}

.cube-text {
  font-size: 30rpx;
  margin-top: 16rpx;
}

.cube-tips { margin-top: 16rpx; }

.cube-tip {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-top: 8rpx;
  color: #475569;
  font-size: 26rpx;
}

.cube-tip-dot {
  color: #2563eb;
  margin-right: 8rpx;
}

.cube-tip-text { flex: 1; }

.cube-stage {
  position: relative;
  margin: 8rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: #e8eef6;
}

.cube-canvas {
  width: 100%;
  height: 560rpx;
  display: block;
}

.cube-stage-hint {
  position: absolute;
  left: 16rpx;
  bottom: 12rpx;
  font-size: 22rpx;
  color: #64748b;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.cube-stage-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  text-align: center;
  color: #b91c1c;
  background: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
}

.cube-alg {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 0;
}

.cube-tok {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 26rpx;
  line-height: 1.4;
  padding: 6rpx 12rpx;
  margin: 0 10rpx 10rpx 0;
  border-radius: 10rpx;
  background: #e2e8f0;
  color: #334155;
}

.cube-tok-on {
  background: #2563eb;
  color: #ffffff;
  font-weight: 600;
}

.cube-tok-done {
  background: #dbeafe;
  color: #1d4ed8;
}

.cube-controls { padding: 8rpx 24rpx 0; }

.cube-progress {
  padding: 8rpx 24rpx 0;
  color: #64748b;
  font-size: 24rpx;
}

.cube-note {
  padding: 8rpx 24rpx 0;
  color: #64748b;
  font-size: 24rpx;
}

.cube-error {
  padding: 8rpx 24rpx 0;
  color: #b91c1c;
  font-size: 24rpx;
}

.cube-solved {
  display: inline-block;
  margin-left: 12rpx;
  color: #15803d;
  font-weight: 600;
}

.cube-raw {
  padding: 0 24rpx;
  color: #64748b;
  font-size: 22rpx;
  word-break: break-all;
}

.cube-swatches {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.cube-swatch {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  margin: 8rpx 12rpx 8rpx 0;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
}

.cube-swatch-u { background: #f5cc14; }
.cube-swatch-d { background: #f0f0f2; }
.cube-swatch-f { background: #009c45; }
.cube-swatch-b { background: #004fb8; }
.cube-swatch-r { background: #cc1724; }
.cube-swatch-l { background: #ff730a; }

.cube-net { margin-top: 8rpx; }

.cube-net-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}

.cube-net-gap { width: 96rpx; }

.cube-face {
  width: 84rpx;
  height: 84rpx;
  border-radius: 12rpx;
  margin-right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #0f172a;
}

.cube-face-u { background: #f5cc14; }
.cube-face-d { background: #f0f0f2; }
.cube-face-f { background: #009c45; color: #ffffff; }
.cube-face-b { background: #004fb8; color: #ffffff; }
.cube-face-r { background: #cc1724; color: #ffffff; }
.cube-face-l { background: #ff730a; color: #ffffff; }

.cube-k {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-weight: 600;
  margin-right: 12rpx;
  flex-shrink: 0;
}
