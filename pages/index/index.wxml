<view class="cube-page">
  <view class="cube-card">
    <view class="cube-h1">魔方教学</view>
    <view class="cube-muted">正在打开课程…</view>
    <view class="cube-muted" wx:if="{{failed}}">课程加载失败，请检查网络后重试，或更新微信</view>
    <button
      wx:if="{{failed}}"
      class="cube-btn"
      hover-class="cube-btn-hover"
      bindtap="retry"
      disabled="{{retrying}}"
    >{{retrying ? '正在重试…' : '重试'}}</button>
    <button
      wx:else
      class="cube-btn"
      hover-class="cube-btn-hover"
      bindtap="go"
      disabled="{{retrying}}"
    >进入魔方教学</button>
  </view>
</view>
